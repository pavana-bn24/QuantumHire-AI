# ---------------------------------------------------------------------------
# QuantumHire AI - frontend environment template
# Copy to `.env`. Only VITE_* variables are exposed to the browser, so never
# put server secrets (API keys, DB URIs) in this file.
# ---------------------------------------------------------------------------

# Leave empty to use the same-origin /api proxy configured in Vite.
VITE_API_BASE_URL=
VITE_APP_NAME=QuantumHire AI
