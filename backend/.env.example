# ---------------------------------------------------------------------------
# QuantumHire AI - backend environment template
# Copy to `.env` and fill in real values. NEVER commit the `.env` file.
# ---------------------------------------------------------------------------

# Application
APP_NAME="QuantumHire AI API"
ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api

# MongoDB connection (no credentials for local dev)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=quantumhire
MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000

# CORS - comma separated list of allowed frontend origins.
# The Vite development server runs on port 5000; its /api proxy is same-origin.
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Seed behaviour: create default role + demo candidates on startup
SEED_ON_STARTUP=true

# --- Resume upload -----------------------------------------------------
# 10 MB ceiling; PDF only.
MAX_RESUME_SIZE_MB=10
RESUME_MIN_CHARS=80

# --- AI / LLM provider -------------------------------------------------
# LLM_PROVIDER: none | stub | openai (defaults to stub when no env file is present)
#   none   -> extraction endpoints return a clear 503 provider error
#   stub   -> offline, deterministic, rule-based extractor that ONLY reports
#             values literally present in the resume (demo / tests, no key)
#   openai -> any OpenAI-compatible /chat/completions endpoint
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=90

# --- Knowledge base (RAG) ------------------------------------------------
# Markdown documents used for keyword retrieval (defaults to backend/knowledge)
KNOWLEDGE_DIR=
KNOWLEDGE_TOP_K=4

# --- Auth (JWT) ----------------------------------------------------------
# CHANGE THESE for anything beyond a local demo. Never commit real secrets.
# Required: set a long random value in Replit Secrets. SESSION_SECRET is accepted as a fallback.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=720
# Required to seed a demo recruiter. Store both values in Replit Secrets.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Integrations --------------------------------------------------------
# Outbound webhook for workflow events (empty -> simulated delivery + log)
EXTERNAL_WEBHOOK_URL=
WEBHOOK_TIMEOUT_SECONDS=10
